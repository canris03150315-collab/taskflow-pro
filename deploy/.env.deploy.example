#!/usr/bin/env bash
# deploy/.env.deploy.example — 範本（此檔可入 git，不含真實密鑰）
#
# 用法：複製成同目錄的 deploy/.env.deploy 並填入真實值。
#       真實的 deploy/.env.deploy 已被 .gitignore，不會進版控。
#
# 產生強隨機值：
#   JWT_SECRET    → openssl rand -hex 32
#   SERVICE_TOKEN → openssl rand -hex 24
#   GEMINI_KEY    → Google AI Studio / Cloud Console 產生
#
# ⚠️ 換 JWT_SECRET 後所有人的登入 token 會失效、需重新登入（輪替的正常代價）。
# ⚠️ SERVICE_TOKEN 是總部↔子公司互相認證用，四台要一起換、一起 deploy。

declare -A SERVER_IP=(
  [alpha]="<alpha 主機 IP>"
  [bravo]="<bravo 主機 IP>"
  [charlie]="<charlie 主機 IP>"
  [central]="<central 主機 IP>"
)

declare -A SERVER_TOKEN=(
  [alpha]="<openssl rand -hex 24>"
  [bravo]="<openssl rand -hex 24>"
  [charlie]="<openssl rand -hex 24>"
  [central]="<openssl rand -hex 24>"
)

declare -A SERVER_JWT=(
  [alpha]="<openssl rand -hex 32>"
  [bravo]="<openssl rand -hex 32>"
  [charlie]="<openssl rand -hex 32>"
  [central]="<openssl rand -hex 32>"
)

GEMINI_KEY="<你的 Gemini API key>"
